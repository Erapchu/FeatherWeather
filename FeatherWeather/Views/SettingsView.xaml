<UserControl
    x:Class="FeatherWeather.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="clr-namespace:FeatherWeather.Resources"
    xmlns:viewModels="clr-namespace:FeatherWeather.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type={x:Type viewModels:SettingsViewModel}, IsDesignTimeCreatable=False}">
    <Grid Margin="28">
        <StackPanel>
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Text="{Binding Source={x:Static resources:LocalizationManager.Instance}, Path=[SettingsTitle]}" />

            <Border
                Margin="0,24,0,0"
                Style="{StaticResource MetricCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="{Binding Source={x:Static resources:LocalizationManager.Instance}, Path=[ThemeLabel]}" />
                        <TextBlock
                            Margin="0,4,20,0"
                            Opacity="0.68"
                            Text="{Binding Source={x:Static resources:LocalizationManager.Instance}, Path=[ThemeDescription]}" />
                    </StackPanel>

                    <ComboBox
                        Grid.Column="1"
                        MinWidth="150"
                        VerticalAlignment="Center"
                        SelectedValue="{Binding SelectedTheme, Mode=TwoWay}"
                        SelectedValuePath="Tag">
                        <ComboBoxItem Content="{Binding Source={x:Static resources:LocalizationManager.Instance}, Path=[ThemeSystem]}" Tag="System" />
                        <ComboBoxItem Content="{Binding Source={x:Static resources:LocalizationManager.Instance}, Path=[ThemeLight]}" Tag="Light" />
                        <ComboBoxItem Content="{Binding Source={x:Static resources:LocalizationManager.Instance}, Path=[ThemeDark]}" Tag="Dark" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border
                Margin="0,12,0,0"
                Style="{StaticResource MetricCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="{Binding Source={x:Static resources:LocalizationManager.Instance}, Path=[LanguageLabel]}" />
                        <TextBlock
                            Margin="0,4,20,0"
                            Opacity="0.68"
                            Text="{Binding Source={x:Static resources:LocalizationManager.Instance}, Path=[LanguageDescription]}" />
                    </StackPanel>

                    <ComboBox
                        Grid.Column="1"
                        MinWidth="150"
                        VerticalAlignment="Center"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding Languages}"
                        SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                        SelectedValuePath="Code" />
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
