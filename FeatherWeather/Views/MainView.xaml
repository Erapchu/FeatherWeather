<UserControl x:Class="FeatherWeather.Views.MainView"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resources="clr-namespace:FeatherWeather.Resources"
        xmlns:viewModels="clr-namespace:FeatherWeather.ViewModels"
        xmlns:controls="clr-namespace:FeatherWeather.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type={x:Type viewModels:MainViewModel}, IsDesignTimeCreatable=False}"
        FlowDirection="{Binding Source={x:Static resources:LocalizationManager.Instance}, Path=FlowDirection}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="SavedCityButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavigationButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="Margin" Value="4,6" />
            <Setter Property="Padding" Value="6,12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style TargetType="Control">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Control">
                                    <Border
                                        BorderBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                        BorderThickness="2"
                                        CornerRadius="5"
                                        IsHitTestVisible="False" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    RecognizesAccessKey="True" />
                            </Border>
                            <Border
                                Width="3"
                                Height="24"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{TemplateBinding BorderBrush}"
                                CornerRadius="1.5" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavigationLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>
    <Grid RowDefinitions="50 *">
        <Grid Grid.Row="0" ColumnDefinitions="180 * 150">
            <StackPanel
                Margin="22,0,0,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <Image
                    Width="16"
                    Height="16"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    RenderOptions.BitmapScalingMode="HighQuality"
                    SnapsToDevicePixels="True"
                    Source="/FeatherWeather;component/Assets/FeatherWeather.ico" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="{Binding Source={x:Static resources:LocalizationManager.Instance}, Path=[AppTitle]}"/>
            </StackPanel>
            <Grid Grid.Column="1" Margin="12,0" MaxWidth="600"
                  VerticalAlignment="Center"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSettingsVisible}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCityCommand}" />
                </Grid.InputBindings>
                <controls:AutoSuggestBox
                    Height="36"
                    Text="{Binding City, UpdateSourceTrigger=PropertyChanged}"
                    ItemsSource="{Binding CitySuggestions}"
                    SelectedItem="{Binding SelectedCitySuggestion}"
                    IsSuggestionListOpen="{Binding IsCitySuggestionsOpen}"
                    DisplayMemberPath="DisplayName"
                    TextMemberPath="Name"
                    PlaceholderText="{Binding Source={x:Static resources:LocalizationManager.Instance}, Path=[CityInputToolTip]}"
                    ToolTip="{Binding Source={x:Static resources:LocalizationManager.Instance}, Path=[CityInputToolTip]}" />
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
                <Grid>
                    <Button
                        VerticalAlignment="Top"
                        Command="{Binding ShowWeatherCommand}"
                        AutomationProperties.Name="{Binding Source={x:Static resources:LocalizationManager.Instance}, Path=[NavigationWeatherToolTip]}"
                        ToolTip="{Binding Source={x:Static resources:LocalizationManager.Instance}, Path=[NavigationWeatherToolTip]}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsVisible}" Value="False">
                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xE706;" FontSize="22" />
                            <TextBlock Style="{StaticResource NavigationLabelStyle}" Text="{Binding Source={x:Static resources:LocalizationManager.Instance}, Path=[NavigationWeatherToolTip]}" />
                        </StackPanel>
                    </Button>

                    <Button
                        VerticalAlignment="Bottom"
                        Command="{Binding ShowSettingsCommand}"
                        AutomationProperties.Name="{Binding Source={x:Static resources:LocalizationManager.Instance}, Path=[NavigationSettingsToolTip]}"
                        ToolTip="{Binding Source={x:Static resources:LocalizationManager.Instance}, Path=[NavigationSettingsToolTip]}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavigationButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsVisible}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel>
                            <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource SymbolThemeFontFamily}" Text="&#xE713;" FontSize="22" />
                            <TextBlock Style="{StaticResource NavigationLabelStyle}" Text="{Binding Source={x:Static resources:LocalizationManager.Instance}, Path=[NavigationSettingsToolTip]}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSettingsVisible}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <ScrollViewer>
                    <StackPanel Margin="28">
                        <ItemsControl ItemsSource="{Binding SavedCities}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Margin" Value="0,0,0,18" />
                                    <Style.Triggers>
                                        <Trigger Property="HasItems" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,8,8" Padding="2" BorderThickness="1" CornerRadius="4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                                                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                                        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource SavedCityButtonStyle}"
                                                    ToolTip="{Binding Place.DisplayName}"
                                                    Command="{Binding DataContext.SelectSavedCityCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding Place.Name}" MaxWidth="180" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                            <Button Width="40" Height="40" Padding="0" Margin="2,0,0,0"
                                                    Style="{StaticResource SavedCityButtonStyle}"
                                                    ToolTip="{Binding Source={x:Static resources:LocalizationManager.Instance}, Path=[RemoveSavedCityToolTip]}"
                                                    AutomationProperties.Name="{Binding Source={x:Static resources:LocalizationManager.Instance}, Path=[RemoveSavedCityToolTip]}"
                                                    Command="{Binding DataContext.RemoveSavedCityCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="14" Text="&#xE711;" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    <Grid RowDefinitions="Auto 24 Auto 18 Auto 18 Auto * Auto">

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayCity}" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding UpdatedText}" Margin="0,4,0,0" Opacity="0.68" />
                            </StackPanel>

                            <Button 
                                Grid.Column="2"
                                Width="42"
                                Height="36"
                                ToolTip="{Binding Source={x:Static resources:LocalizationManager.Instance}, Path=[RefreshWeatherToolTip]}"
                                Command="{Binding RefreshCommand}">
                                <TextBlock
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    FontSize="16"
                                    Text="&#xE72C;" />
                            </Button>
                        </Grid>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding WeatherGlyph}" FontFamily="Segoe UI Symbol" FontSize="72" VerticalAlignment="Center" />

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TemperatureText}" FontSize="58" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="{Binding ConditionText}" FontSize="18" Margin="2,0,0,0" />
                                <TextBlock Text="{Binding FeelsLikeText}" Margin="2,5,0,0" Opacity="0.68" />
                            </StackPanel>
                        </Grid>

                        <UniformGrid Grid.Row="4" Columns="3">
                            <Border Style="{StaticResource MetricCardStyle}" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static resources:LocalizationManager.Instance}, Path=[HumidityLabel]}" Opacity="0.68" />
                                    <TextBlock Text="{Binding HumidityText}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCardStyle}" Margin="4,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static resources:LocalizationManager.Instance}, Path=[WindLabel]}" Opacity="0.68" />
                                    <TextBlock Text="{Binding WindText}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricCardStyle}" Margin="8,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Source={x:Static resources:LocalizationManager.Instance}, Path=[PressureLabel]}" Opacity="0.68" />
                                    <TextBlock Text="{Binding PressureText}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <StackPanel Grid.Row="6">
                            <TextBlock Text="{Binding Source={x:Static resources:LocalizationManager.Instance}, Path=[HourlyForecastHeading]}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <ItemsControl ItemsSource="{Binding HourlyItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel HorizontalAlignment="Center" Margin="4">
                                            <TextBlock Text="{Binding Time}" HorizontalAlignment="Center" Opacity="0.68" />
                                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Symbol" FontSize="24" HorizontalAlignment="Center" Margin="0,7" />
                                            <TextBlock Text="{Binding Temperature}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Row="7" Margin="0,18,0,0">
                            <TextBlock Text="{Binding Source={x:Static resources:LocalizationManager.Instance}, Path=[SevenDayForecastHeading]}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding DailyItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="34">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="45" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="70" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Day}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Glyph}" FontFamily="Segoe UI Symbol" FontSize="18" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Condition}" VerticalAlignment="Center" Opacity="0.68" />
                                            <TextBlock Grid.Column="3" Text="{Binding Range}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Grid.Row="8" Margin="0,14,0,0" Opacity="0.68" Text="{Binding StatusText}" />
                    </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <ContentControl
                Grid.Column="1"
                Content="{Binding SettingsContent, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSettingsVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
