<UserControl x:Class="FeatherWeather.Controls.AutoSuggestBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Focusable="False">
    <Grid>
        <TextBox x:Name="InputBox"
                 Height="{Binding ElementName=Root, Path=InputHeight}"
                 Padding="10,0"
                 Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                 VerticalContentAlignment="Center"
                 Text="{Binding ElementName=Root, Path=Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="{Binding ElementName=Root, Path=ToolTip}" />

        <Popup x:Name="SuggestionsPopup"
               AllowsTransparency="True"
               IsOpen="{Binding ElementName=Root, Path=IsSuggestionListOpen, Mode=TwoWay}"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=InputBox}"
               PopupAnimation="Fade"
               StaysOpen="False">
            <Border Width="{Binding ElementName=InputBox, Path=ActualWidth}"
                    MaxHeight="300"
                    Margin="0,4,0,0"
                    Padding="4"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                <ListBox x:Name="SuggestionsList"
                         BorderThickness="0"
                         Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                         DisplayMemberPath="{Binding ElementName=Root, Path=DisplayMemberPath}"
                         ItemsSource="{Binding ElementName=Root, Path=ItemsSource}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,7" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBackground"
                                                Padding="{TemplateBinding Padding}"
                                                Background="Transparent"
                                                CornerRadius="5">
                                            <ContentPresenter
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBackground"
                                                        Property="Background"
                                                        Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBackground"
                                                        Property="Background"
                                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
