<Window x:Class="FeatherWeather.MainWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:resources="clr-namespace:FeatherWeather.Resources"
        FlowDirection="{Binding Source={x:Static resources:LocalizationManager.Instance}, Path=FlowDirection}"
        Title="{Binding Source={x:Static resources:LocalizationManager.Instance}, Path=[AppTitle]}"
        Width="760" Height="610"
        MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <Image
            x:Name="StartupLogo"
            Width="86"
            Height="86"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            RenderOptions.BitmapScalingMode="HighQuality"
            Source="Assets/FeatherWeather_Medium.png" />
        <ContentControl x:Name="MainContent" />
    </Grid>
</Window>
